# outputs: only the saved simulation outputs and figures are tracked;
# everything else the analysis scripts write is regenerated
output/figures/*
!output/figures/.gitkeep
!output/figures/sim_*.png
output/sim/*
!output/sim/.gitkeep
!output/sim/sim_*.csv
!output/sim/null_coupling_summary.csv
!output/sim/pilot_g2_cause_summary.csv
!output/sim/pilot_model_terms.csv

